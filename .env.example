# Hevy personal connector (per-user API key, Hevy Pro required).
# There is no app-level credential — every key belongs to an individual user.
HEVY_ENCRYPTION_KEY=<openssl rand -hex 32>
HEVY_STORE_PATH=/data/store.json

# Public origin used to build the one-time enrollment link (/hevy/enroll).
HEVY_PUBLIC_BASE_URL=https://hevy.mcp.example.com

HEVY_TRUST_FORWARDED_USER=true
HEVY_ENABLE_WRITES=true
HEVY_AUDIT_LOG=/data/audit.jsonl
HEVY_TIMEOUT_MS=30000

# Local stdio development only — never set in a hosted deployment.
HEVY_DEV_USER=

# Shared bearer the gateway sends on /mcp (Authorization: Bearer <token>). REQUIRED
# when HEVY_TRUST_FORWARDED_USER=true — the server refuses to start without it.
# Use a long random value, e.g. `openssl rand -hex 32`. Never commit.
MCP_HTTP_TOKEN=
